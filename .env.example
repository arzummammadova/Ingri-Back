PORT=4871
# MongoDB Atlas connection string
MONGO_URI=mongodb+srv://USER:PASSWORD@CLUSTER.mongodb.net/learn-english?retryWrites=true&w=majority
JWT_SECRET=replace-with-a-long-random-string
# Comma-separated browser origins allowed to call the API with cookies
FRONTEND_ORIGIN=http://127.0.0.1:43123,http://localhost:43123
NODE_ENV=development

# Gmail SMTP (Google account → Security → App passwords)
EMAIL_USER=yourname@gmail.com
EMAIL_PASS=your-gmail-app-password
EMAIL_FROM=Ingri <yourname@gmail.com>

# Optional. When empty, avatars are stored on disk under back/uploads.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Ingri chat bot (first key that is set is used). Gemini: https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
